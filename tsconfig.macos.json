{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "declarationMap": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "jest"],
    "skipLibCheck": true
  },
  "include": [
    "src/main/macos/**/*.ts",
    "src/main/components/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/macos/**/*.tsx"
  ]
}
